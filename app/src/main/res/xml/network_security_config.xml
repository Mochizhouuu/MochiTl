<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9+ memblokir cleartext (HTTP) secara default. MochiTL mendukung
    server LLM lokal (Ollama / LM Studio) di IP LAN, mis. http://192.168.1.5:11434
    — domain-config hanya bisa mencocokkan hostname persis, bukan rentang IP,
    sehingga cleartext diizinkan di base-config.

    Provider cloud (Gemini, OpenAI, OpenRouter) tetap memakai URL HTTPS sehingga
    trafiknya tetap terenkripsi. Hanya URL http:// eksplisit yang memakai cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
